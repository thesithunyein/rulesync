# Server only. Copy to .env and fill in. Never commit .env.
# None of these values are sent to the browser.

# Tatum Sui Mainnet GraphQL: https://sui-mainnet.gateway.tatum.io/graphql
TATUM_API_KEY=

# Walrus Memory Mainnet. Create the account at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=rulesync

# Optional. A Sui address to read when the app opens. 0x plus 64 hex characters.
SUI_ADDRESS=
